	{
		"id" : 18,
		"account_id" : 1,
		"name" : "send_template_5527992297408",
		"description" : "send_template_5527992297408",
		"event_name" : "message_created",
		"conditions" : "[{\"values\": [\"Olá! Para garantir que você aproveite ao máximo nosso sistema\", \" é fundamental agendar seu treinamento. Estamos ansiosos para te ajudar a iniciar essa nova fase com sucesso!\"], \"attribute_key\": \"content\", \"query_operator\": \"or\", \"filter_operator\": \"contains\", \"custom_attribute_type\": \"\"}, {\"values\": [\"Olá! Para agilizar sua rotina e aproveitar todas as ferramentas da nossa plataforma\", \" o primeiro passo é o seu treinamento. Vamos marcar um horário para começar com tudo?\"], \"attribute_key\": \"content\", \"query_operator\": \"or\", \"filter_operator\": \"contains\", \"custom_attribute_type\": \"\"}, {\"values\": [\"Olá! Atenção: A carga dos cartões de seus colaboradores ainda não foi gerada. Para que eles não percam o acesso aos benefícios\", \" é essencial que a carga seja feita o quanto antes.\"], \"attribute_key\": \"content\", \"query_operator\": \"or\", \"filter_operator\": \"contains\", \"custom_attribute_type\": \"\"}, {\"values\": [\"Olá! Seja bem-vindo(a) à família LeCard. Eu sou do time de Customer Experience e\", \" a partir de agora\", \" estarei aqui para te dar todo o suporte que precisar. Botões de Chamada para Ação:\"], \"attribute_key\": \"content\", \"query_operator\": \"or\", \"filter_operator\": \"contains\", \"custom_attribute_type\": \"\"}, {\"values\": [\"Olá! Para nós da LeCard\", \" sua experiência é o que mais importa. Gostaríamos de saber como está a satisfação com o uso de nossos cartões. Sua opinião nos ajuda a evoluir!\"], \"attribute_key\": \"content\", \"query_operator\": \"or\", \"filter_operator\": \"contains\", \"custom_attribute_type\": \"\"}, {\"values\": [\"Olá\", \" somos da Le Card e precisamos conversar com você. Tem disponibilidade agora?\"], \"attribute_key\": \"content\", \"query_operator\": \"or\", \"filter_operator\": \"contains\", \"custom_attribute_type\": \"\"}, {\"values\": [\"Olá! Lembrete: a carga dos cartões ainda precisa ser agendada. Agende o processo para ativar os benefícios de seus colaboradores.\"], \"attribute_key\": \"content\", \"query_operator\": \"or\", \"filter_operator\": \"contains\", \"custom_attribute_type\": \"\"}, {\"values\": [\"Olá! Passando para lembrar que hoje é o dia da sua carga de cartões. Nossa equipe está à disposição para te dar todo o suporte necessário e garantir que o processo seja um sucesso!\"], \"attribute_key\": \"content\", \"filter_operator\": \"contains\", \"custom_attribute_type\": \"\"}]",
		"actions" : "[{\"action_name\": \"send_webhook_event\", \"action_params\": [\"https:\/\/lecardwhv3.omniflex.com.br\/webhook\/aa776bf3-76ef-4f12-805f-8db35caa02c7\"]}]",
