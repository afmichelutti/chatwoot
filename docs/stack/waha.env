# =============================================================================
# WAHA (WhatsApp HTTP API) - Variáveis de Ambiente (Portainer)
# =============================================================================
#
# Cadastrar todas as variáveis abaixo nas "Stack environment variables" do
# Portainer antes do deploy. Não use aspas nos valores (Portainer != .env local).
#
# =============================================================================

# ===== API Key (chave master de autenticação) =====
# Usada como X-Api-Key nas requisições à API. Gerar com: openssl rand -hex 32
WAHA_API_KEY=COLE_AQUI_KEY_FORTE_GERADA_COM_OPENSSL

# ===== Dashboard (UI web) =====
# Acessar em https://waha.appio.com.br/dashboard
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=COLE_AQUI_SENHA_FORTE_DASHBOARD

# ===== Swagger (UI da API) =====
# Acessar em https://waha.appio.com.br/api
WAHA_SWAGGER_USERNAME=admin
WAHA_SWAGGER_PASSWORD=COLE_AQUI_SENHA_FORTE_SWAGGER

# =============================================================================
# Opcionais (descomentar tanto aqui quanto no yaml)
# =============================================================================

# ===== Bright Data Proxy (se usar) =====
# WAHA_PROXY_USERNAME=brd-customer-hl_XXXXXXXX-zone-isp_proxy_whastapp
# WAHA_PROXY_PASSWORD=SUA_SENHA_BRIGHT_DATA

# ===== Webhook global (se usar) =====
# WAHA_HOOK_URL=https://n8n.appio.com.br/webhook/waha

# =============================================================================
# Checklist antes do primeiro deploy
# =============================================================================
#   [ ] DNS waha.appio.com.br → IP da VPS (Cloudflare proxy off no início)
#   [ ] docker login -u devlikeapro -p <DOCKER_HUB_KEY> feito na VPS
#   [ ] Volumes externos criados:
#         docker volume create waha_sessions
#         docker volume create waha_media
#         docker volume create redis_waha_data
#   [ ] WAHA_API_KEY gerado com openssl rand -hex 32
#   [ ] Senhas fortes definidas pra dashboard e swagger
#   [ ] Variáveis obrigatórias preenchidas:
#         WAHA_API_KEY
#         WAHA_DASHBOARD_PASSWORD
#         WAHA_SWAGGER_PASSWORD
# =============================================================================
