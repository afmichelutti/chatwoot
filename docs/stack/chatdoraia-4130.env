# =============================================================================
# Plataforma v4.13.0 - DORAIA - Variáveis de Ambiente (Portainer)
# =============================================================================

# ===== Identificação =====
DORAIA_INSTALLATION_NAME=Doraia Plataforma

# ===== SECRET_KEY_BASE =====
# OBRIGATÓRIO. Gerar com: openssl rand -hex 64
DORAIA_SECRET_KEY_BASE=COLE_AQUI_O_HEX_DE_64_CARACTERES_GERADO_COM_OPENSSL

# ===== PostgreSQL =====
# Database NOVO 'chat' (lembre de criar antes:
#   docker exec postgres psql -U postgres -c "CREATE DATABASE chat;")
DORAIA_POSTGRES_HOST=postgres
DORAIA_POSTGRES_PORT=5432
DORAIA_POSTGRES_USERNAME=postgres
DORAIA_POSTGRES_PASSWORD=SENHA_DO_POSTGRES_DA_VPS

# ===== MinIO (S3-compatible) =====
# Bucket 'doraia' já criado no MinIO. Service Account com read/write.
DORAIA_STORAGE_ACCESS_KEY_ID=COLE_AQUI_O_ACCESS_KEY_DO_SERVICE_ACCOUNT
DORAIA_STORAGE_SECRET_ACCESS_KEY=COLE_AQUI_O_SECRET_KEY_DO_SERVICE_ACCOUNT
DORAIA_STORAGE_REGION=us-east-1
DORAIA_STORAGE_BUCKET_NAME=doraia
DORAIA_STORAGE_ENDPOINT=https://minio.doraia.com.br

# ===== SMTP =====
DORAIA_MAILER_SENDER_EMAIL=Doraia <noreply@doraia.com.br>
DORAIA_SMTP_ADDRESS=smtp.sendgrid.net
DORAIA_SMTP_PORT=587
DORAIA_SMTP_USERNAME=apikey
DORAIA_SMTP_PASSWORD=SG.XXXXXXXXXXXXXXXXXXXXXXXXXXXX
DORAIA_SMTP_DOMAIN=doraia.com.br

# =============================================================================
# Variáveis FIXAS no yaml (referência)
# =============================================================================
#   FRONTEND_URL=https://chat.doraia.com.br
#   POSTGRES_DATABASE=chat
#   STORAGE_FORCE_PATH_STYLE=true
#   ACTIVE_STORAGE_SERVICE=s3_compatible
#   DEFAULT_LOCALE=pt_BR
#   FORCE_SSL=true
#   ENABLE_ACCOUNT_SIGNUP=false
#
# =============================================================================
# Checklist antes do primeiro deploy
# =============================================================================
#   [ ] DNS chat.doraia.com.br → IP da VPS (Cloudflare proxy off no início)
#   [ ] Database 'chat' criado e VAZIO no Postgres
#   [ ] Imagem afmichelutti/appio_cw_4130:doraia buildada e pushada
#   [ ] Bucket MinIO 'doraia' criado + service account com policy r/w no bucket
#   [ ] STORAGE_ENDPOINT acessível do container Plataforma:
#       curl -sI https://minio.doraia.com.br/minio/health/live
#   [ ] Sender email validado no SendGrid
#   [ ] DORAIA_SECRET_KEY_BASE gerado com openssl rand -hex 64
#   [ ] Variáveis obrigatórias preenchidas:
#         DORAIA_SECRET_KEY_BASE
#         DORAIA_POSTGRES_PASSWORD
#         DORAIA_STORAGE_ACCESS_KEY_ID
#         DORAIA_STORAGE_SECRET_ACCESS_KEY
#         DORAIA_STORAGE_BUCKET_NAME
#         DORAIA_STORAGE_ENDPOINT
#         DORAIA_SMTP_PASSWORD
# =============================================================================
