# =============================================
# Chatwoot Appio 4.11.1 - Environment Variables
# Versão OFICIAL de produção - E-mail via AWS SES
# =============================================
# Copie estas variáveis para o Portainer ao criar a stack
# Substitua os valores <PREENCHER> com os dados reais
# =============================================

# ===== Configuração Básica =====
APP_INSTALLATION_NAME=Appio
APP_SECRET_KEY_BASE=<GERAR_NOVO>

# Para gerar um novo secret key:
# docker exec <qualquer_container_rails> bundle exec rails secret
# Ou: openssl rand -hex 64

# ===== PostgreSQL =====
APP_POSTGRES_HOST=postgres
APP_POSTGRES_PORT=5432
APP_POSTGRES_USERNAME=<PREENCHER>
APP_POSTGRES_PASSWORD=<PREENCHER>
# Database fixo no YAML: chat_appio

# ===== AWS S3 =====
APP_AWS_ACCESS_KEY_ID=<S3_ACCESS_KEY>
APP_AWS_SECRET_ACCESS_KEY=<S3_SECRET_KEY>
APP_AWS_REGION=sa-east-1
APP_S3_BUCKET_NAME=<NOME_BUCKET>

# ===== AWS SES (E-mail Transacional) =====
# IMPORTANTE: SES SMTP credentials são DIFERENTES da access key do S3.
# Geração:
#   AWS Console → SES → SMTP Settings → Create SMTP Credentials
#   (cria um IAM user dedicado com permissão ses:SendRawEmail)
#
# Pré-requisitos antes de mandar e-mail real:
#   1. Verificar domínio em SES → Verified identities (DKIM + SPF + DMARC)
#   2. Sair do sandbox SES → SES → Account Dashboard → Request production access
#      (no sandbox SES você só envia para endereços verificados)
#   3. MAILER_SENDER_EMAIL precisa estar no domínio verificado
#
# Endpoints SMTP por região (escolha a mesma região onde verificou o domínio):
#   sa-east-1: email-smtp.sa-east-1.amazonaws.com
#   us-east-1: email-smtp.us-east-1.amazonaws.com
#   us-west-2: email-smtp.us-west-2.amazonaws.com
#
APP_MAILER_SENDER_EMAIL=no-reply@appio.com.br
APP_SMTP_ADDRESS=email-smtp.sa-east-1.amazonaws.com
APP_SMTP_PORT=587
APP_SES_SMTP_USERNAME=<SES_SMTP_USERNAME>
APP_SES_SMTP_PASSWORD=<SES_SMTP_PASSWORD>
APP_SMTP_DOMAIN=appio.com.br
