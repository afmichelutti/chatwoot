# =============================================
# Chatwoot Sandbox 4.11.1 - Environment Variables
# =============================================
# Copie estas variáveis para o Portainer ao criar a stack
# Substitua os valores <PREENCHER> com os dados reais
#
# DICA: Os valores de S3, SMTP e Postgres user/pass
# são os mesmos da produção (CW_*)
# =============================================

# ===== Configuração Básica =====
SAND_INSTALLATION_NAME=Appio Sandbox
SAND_SECRET_KEY_BASE=<GERAR_NOVO>

# Para gerar um novo secret key:
# docker exec <qualquer_container_rails> bundle exec rails secret
# Ou: openssl rand -hex 64

# ===== PostgreSQL (mesmo servidor, DB diferente) =====
SAND_POSTGRES_HOST=postgres
SAND_POSTGRES_PORT=5432
SAND_POSTGRES_USERNAME=<MESMO_DA_PRODUCAO>
SAND_POSTGRES_PASSWORD=<MESMO_DA_PRODUCAO>
# Database já definido fixo no YAML: chat_sand

# ===== AWS S3 (mesmo da produção) =====
SAND_AWS_ACCESS_KEY_ID=<MESMO_DA_PRODUCAO>
SAND_AWS_SECRET_ACCESS_KEY=<MESMO_DA_PRODUCAO>
SAND_AWS_REGION=sa-east-1
SAND_S3_BUCKET_NAME=<MESMO_DA_PRODUCAO>

# ===== SMTP (mesmo da produção) =====
SAND_MAILER_SENDER_EMAIL=<MESMO_DA_PRODUCAO>
SAND_SMTP_ADDRESS=smtp.sendgrid.net
SAND_SMTP_PORT=587
SAND_SMTP_USERNAME=<MESMO_DA_PRODUCAO>
SAND_SMTP_PASSWORD=<MESMO_DA_PRODUCAO>
SAND_SMTP_DOMAIN=<MESMO_DA_PRODUCAO>
