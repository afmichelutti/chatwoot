# =============================================================================
# Chatwoot v4.13.0 - Cliente Novo - Variáveis de Ambiente (Portainer)
# =============================================================================
#
# Como usar no Portainer:
#   1. Acesse a stack > "Environment variables" (ou "Stack environment")
#   2. Cole estas variáveis preenchendo os valores reais
#   3. Atenção: NÃO use aspas nos valores no Portainer (diferente de .env local)
#
# Para uso LOCAL com docker-compose:
#   1. Salve este arquivo como .env (sem .example) na mesma pasta do yaml
#   2. docker compose --env-file .env up -d
#
# =============================================================================

# ===== Identificação =====
# Nome aparece no header do Chatwoot e em emails
CLI_INSTALLATION_NAME=Cliente XYZ Chatwoot

# ===== SECRET_KEY_BASE =====
# OBRIGATÓRIO. Gerar com: openssl rand -hex 64
# NUNCA reuse a chave de outro ambiente. Se trocar depois, invalida sessões.
CLI_SECRET_KEY_BASE=COLE_AQUI_O_HEX_DE_64_CARACTERES_GERADO_COM_OPENSSL

# ===== PostgreSQL =====
# Mesmo Postgres da VPS, database NOVO (chat_<cliente>)
# Lembre de criar antes:
#   docker exec postgres psql -U postgres -c "CREATE DATABASE chat_cliente;"
CLI_POSTGRES_HOST=postgres
CLI_POSTGRES_PORT=5432
CLI_POSTGRES_USERNAME=postgres
CLI_POSTGRES_PASSWORD=SENHA_DO_POSTGRES_DA_VPS

# Obs: o yaml já fixa POSTGRES_DATABASE=chat_cliente.
# Se quiser nome diferente, edite o yaml E o CREATE DATABASE acima.

# ===== MinIO Storage (S3-compatible, hospedado na VPS) =====
# Antes de configurar, criar bucket dedicado no console MinIO:
#   1. Acessar console MinIO (ex: https://minio-console.appio.com.br)
#   2. Buckets > Create Bucket: chatwoot-cliente
#   3. Identity > Service Accounts > Create:
#        - Anotar Access Key + Secret Key
#        - Policy: dar read/write apenas neste bucket (princípio do menor privilégio)
#   4. Settings > Region: deixar "us-east-1" (default), Chatwoot aceita qualquer valor
#
# STORAGE_ENDPOINT é a URL pública do MinIO (sem trailing slash)
#   Exemplo: https://minio.appio.com.br
#   NÃO use a URL do console (ex: minio-console.*) — use a URL da API S3 do MinIO
#
CLI_STORAGE_ACCESS_KEY_ID=COLE_AQUI_O_ACCESS_KEY_DO_SERVICE_ACCOUNT
CLI_STORAGE_SECRET_ACCESS_KEY=COLE_AQUI_O_SECRET_KEY_DO_SERVICE_ACCOUNT
CLI_STORAGE_REGION=us-east-1
CLI_STORAGE_BUCKET_NAME=chatwoot-cliente
CLI_STORAGE_ENDPOINT=https://minio.appio.com.br

# ===== SMTP (envio de emails: convites, notificações, reset de senha) =====
# Default usa SendGrid. Pode trocar pra outro provedor.
CLI_MAILER_SENDER_EMAIL=Cliente Chatwoot <noreply@cliente.com.br>
CLI_SMTP_ADDRESS=smtp.sendgrid.net
CLI_SMTP_PORT=587
CLI_SMTP_USERNAME=apikey
CLI_SMTP_PASSWORD=SG.XXXXXXXXXXXXXXXXXXXXXXXXXXXX
CLI_SMTP_DOMAIN=cliente.com.br

# =============================================================================
# Variáveis FIXAS no yaml (não precisam estar aqui — só pra referência)
# =============================================================================
#   FRONTEND_URL=https://chatcliente.appio.com.br   ← editar no yaml se mudar
#   POSTGRES_DATABASE=chat_cliente                  ← editar no yaml se mudar
#   DEFAULT_LOCALE=pt_BR
#   FORCE_SSL=true
#   ENABLE_ACCOUNT_SIGNUP=false
#   RAILS_ENV=production
#   NODE_ENV=production
#   INSTALLATION_ENV=docker
#   ACTIVE_STORAGE_SERVICE=s3_compatible
#   STORAGE_FORCE_PATH_STYLE=true                   ← obrigatório pra MinIO
#   SMTP_AUTHENTICATION=plain
#   SMTP_ENABLE_STARTTLS_AUTO=true
#   WEB_CONCURRENCY=2
#   RAILS_MAX_THREADS=5
#   SIDEKIQ_CONCURRENCY=10
#   USE_INBOX_AVATAR_FOR_BOT=true
#   RAILS_LOG_TO_STDOUT=true
#   REDIS_URL=redis://chatwoot_cli_redis:6379/1     ← redis interno do stack
#
# =============================================================================
# Checklist antes do primeiro deploy
# =============================================================================
#   [ ] DNS chatcliente.appio.com.br → IP da VPS (Cloudflare proxy off no início)
#   [ ] Database chat_cliente criado e VAZIO no Postgres
#   [ ] Imagem afmichelutti/appio_cw_4130:cliente buildada e pushada
#   [ ] Bucket MinIO chatwoot-cliente criado + service account com read/write no bucket
#   [ ] STORAGE_ENDPOINT acessível do container Chatwoot (testar com: curl https://minio.appio.com.br/minio/health/live)
#   [ ] Sender email validado no SendGrid (Sender Authentication)
#   [ ] SECRET_KEY_BASE gerado com openssl rand -hex 64
#   [ ] Todas as 6 variáveis CLI_* obrigatórias preenchidas:
#         CLI_SECRET_KEY_BASE
#         CLI_POSTGRES_PASSWORD
#         CLI_STORAGE_ACCESS_KEY_ID
#         CLI_STORAGE_SECRET_ACCESS_KEY
#         CLI_STORAGE_BUCKET_NAME
#         CLI_STORAGE_ENDPOINT
#         CLI_SMTP_PASSWORD
# =============================================================================
